# https://editorconfig.org — cross-editor defaults for TrayIconGuard.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cc,cpp,h,hpp}]
indent_size = 4

[*.{bat,cmd,reg}]
end_of_line = crlf

[*.{sln,vcxproj,filters}]
end_of_line = crlf

[Makefile]
indent_style = tab

# Markdown uses two trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false
