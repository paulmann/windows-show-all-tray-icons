<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme palette (Windows 11 Fluent inspired) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F5F6F8" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5F6368" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0E5FA5" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E8EEF7" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="BorderLine" Color="#D8DCE2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
</ResourceDictionary>
