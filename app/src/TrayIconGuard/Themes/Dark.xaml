<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme palette (Windows 11 Fluent inspired) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="PanelBackground" Color="#272727" />
    <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A6A6A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3AA8E0" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#323232" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="BorderLine" Color="#3F3F3F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="InputBackground" Color="#2B2B2B" />
</ResourceDictionary>
