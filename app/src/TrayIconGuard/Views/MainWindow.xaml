<Window x:Class="TrayIconGuard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayIconGuard - Show All Tray Icons"
        Height="640" Width="960" MinHeight="480" MinWidth="780"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="TrayIconGuard" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding VersionText}" Margin="10,0,0,5" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Bottom" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding WatcherStateText}" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- ============ Toolbar ============ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Show all now" Style="{StaticResource AccentButton}"
                        Command="{Binding ShowAllNowCommand}"
                        ToolTip="Promote every hidden icon immediately (plus legacy switches)" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        ToolTip="Re-read the tray registry without changes" />
                <Button Content="Restore defaults" Click="OnRestoreDefaultsClick"
                        ToolTip="Return all icons to Windows-managed hiding" />
                <Button Content="Restart Explorer" Click="OnRestartExplorerClick"
                        ToolTip="Restart the shell so pending changes apply immediately" />
                <Button Content="{Binding GuardToggleText}" Command="{Binding ToggleGuardCommand}"
                        ToolTip="Suspend/resume automatic promotion" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox Width="230" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Filter by name, executable or id" />
            </StackPanel>
        </DockPanel>

        <!-- ============ Tabs ============ -->
        <TabControl Grid.Row="2">
            <TabItem Header="Icons">
                <ListView ItemsSource="{Binding IconsView}" Margin="0,8,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="70">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Visible"
                                                          ToolTip="Always show this icon on the taskbar" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsPromoted, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ToggleIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="180"
                                            DisplayMemberBinding="{Binding DisplayName}" />
                            <GridViewColumn Header="Status" Width="130"
                                            DisplayMemberBinding="{Binding StatusText}" />
                            <GridViewColumn Header="Executable" Width="360"
                                            DisplayMemberBinding="{Binding ExecutablePath}" />
                            <GridViewColumn Header="Last notification" Width="140"
                                            DisplayMemberBinding="{Binding LastSeenText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10">
                        <GroupBox Header="Guard">
                            <StackPanel Margin="6">
                                <CheckBox Content="Automatically promote icons that Windows hides (core feature)"
                                          IsChecked="{Binding AutoPromoteNewIcons}" />
                                <CheckBox Content="Event-driven monitoring (RegNotifyChangeKeyValue; disable to poll)"
                                          IsChecked="{Binding UseEventDrivenMonitor}" />
                                <CheckBox Content="Restart Explorer automatically after promotions (disruptive, 60 s cooldown)"
                                          IsChecked="{Binding AutoRestartExplorer}" />
                                <CheckBox Content="Show a balloon notification when an icon is auto-promoted"
                                          IsChecked="{Binding ShowBalloonOnPromote}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Poll / re-arm interval (seconds):" VerticalAlignment="Center" />
                                    <TextBox Width="60" Margin="8,0,0,0"
                                             Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Application" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <CheckBox Content="Start minimized to the notification area"
                                          IsChecked="{Binding StartMinimized}" />
                                <CheckBox Content="Minimize/close hides to tray (the guard keeps running)"
                                          IsChecked="{Binding MinimizeToTray}" />
                                <CheckBox Content="Start with Windows (HKCU Run key)"
                                          IsChecked="{Binding StartWithWindows}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Theme:" VerticalAlignment="Center" />
                                    <ComboBox Width="170" Margin="8,0,0,0"
                                              SelectedValue="{Binding Theme}" SelectedValuePath="Tag">
                                        <ComboBoxItem Tag="System" Content="Follow system" />
                                        <ComboBoxItem Tag="Light" Content="Light" />
                                        <ComboBoxItem Tag="Dark" Content="Dark" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Exclusions (never promote these apps)" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                           Text="One entry per line: file name (onedrive.exe), full path (C:\Apps\tool.exe), or wildcard (*teams*)." />
                                <TextBox AcceptsReturn="True" Height="90" Margin="0,6,0,0"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding ExcludedExecutablesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save settings" Style="{StaticResource AccentButton}"
                                    Command="{Binding SaveSettingsCommand}" />
                            <Button Content="Open log folder" Command="{Binding OpenLogsFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Activity log">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0" ItemsSource="{Binding Logs}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="80"
                                                DisplayMemberBinding="{Binding TimeText}" />
                                <GridViewColumn Header="Level" Width="64"
                                                DisplayMemberBinding="{Binding Level}" />
                                <GridViewColumn Header="Message" Width="720"
                                                DisplayMemberBinding="{Binding Message}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Clear view" Command="{Binding ClearLogCommand}" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="Persistent logs: %LOCALAPPDATA%\TrayIconGuard\logs" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,6" CornerRadius="4"
                Background="{DynamicResource CardBackground}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding UptimeText}"
                           Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastScanText}"
                           Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountsText}"
                           Foreground="{DynamicResource TextPrimary}" Margin="16,0,0,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
