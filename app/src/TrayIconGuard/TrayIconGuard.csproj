<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TrayIconGuard</RootNamespace>
    <AssemblyName>TrayIconGuard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003: WinForms dislikes DPI settings in app.manifest, but WPF requires
         PerMonitorV2 there. We only use WinForms for NotifyIcon, so suppress. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Zero NuGet dependencies by design: offline-safe, supply-chain-safe builds. -->
    <RestorePackages>false</RestorePackages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF + WinForms together: drop WinForms implicit usings to avoid
         Application/MessageBox ambiguity; files that need WinForms alias it. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
