{
  "dotnet.defaultSolution": "app/TrayIconGuard.sln",
  "files.associations": {
    "*.psm1": "powershell",
    "*.psd1": "powershell",
    "*.iss": "ini"
  },
  "files.eol": "\n",
  "[bat]": { "files.eol": "\r\n" },
  "powershell.codeFormatting.preset": "OTBS",
  "editor.rulers": [120],
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/artifacts": true
  }
}
