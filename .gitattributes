# Normalize line endings on checkout
* text=auto eol=lf

# Windows-first file types: MUST be CRLF in the working tree
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.reg  text eol=crlf
*.iss  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Binary
*.ico binary
*.png binary
*.exe binary
*.dll binary
*.msi binary

*.md   text eol=lf
*.cs   text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln  text eol=crlf
*.json text eol=lf
*.yml  text eol=lf

# Legacy pre-7.0 files are FROZEN byte-for-byte (LEGACY-NOTICE.md):
# no line-ending normalization on check-in/check-out.
/Enable-AllTrayIcons.bat -text
/Enable-AllTrayIcons.ps1 -text
/disable-auto-hide.reg -text
/enable-all-tray-icons.reg -text

